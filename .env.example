# Gateway environment template for the consolidated CRM Operations Platform.
# Copy to .env and override for local dev or docker-compose.

API_KEY=change-me-dev-key
GATEWAY_PORT=8080
GATEWAY_TIMEOUT=30.0

# Upstream agent URLs (used by the gateway)
COMPLIANCE_MONITOR_URL=http://compliance_monitor:8000
TASK_AUTOMATION_URL=http://task_automation:8000
FOLLOW_UP_SEQUENCES_URL=http://follow_up_sequences:8000
FEEDBACK_LOOP_URL=http://feedback_loop:8000
PERFORMANCE_ANALYTICS_URL=http://performance_analytics:8000

# Per-agent timeouts (seconds). Override if a specific engine is slower.
COMPLIANCE_MONITOR_TIMEOUT=10.0
TASK_AUTOMATION_TIMEOUT=30.0
FOLLOW_UP_SEQUENCES_TIMEOUT=15.0
FEEDBACK_LOOP_TIMEOUT=20.0
PERFORMANCE_ANALYTICS_TIMEOUT=30.0

# Optional: Postgres URL if the gateway ever needs a shared platform DB.
DATABASE_URL=
