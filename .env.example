# Gateway environment template for the consolidated CRM Operations Platform.
# Copy this file to `.env` and override for local development or Docker Compose.
# Variables here are loaded by `config/settings.py` via `pydantic-settings`.

# =============================================================================
# Runtime environment
# =============================================================================
# Environment name. Controls whether the default dev API key and wildcard CORS
# are accepted. Use `local`, `dev`, or `development` for local work.
ENV=local

# Log level for the gateway.
LOG_LEVEL=INFO

# =============================================================================
# Gateway / API server
# =============================================================================
# Port the gateway binds to.
GATEWAY_PORT=8080

# Default upstream request timeout (seconds).
GATEWAY_TIMEOUT=30.0

# Shared X-API-Key. Rotate to a strong secret in staging/production.
# The default value `change-me-dev-key` is only accepted when ENV is local.
API_KEY=change-me-dev-key

# When true, reject the default dev API key in non-local environments.
GATEWAY_REJECT_DEFAULT_KEY=true

# =============================================================================
# CORS
# =============================================================================
# Allowed CORS origins. JSON array. Wildcard "*" is rejected in non-local envs.
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Upstream agent URLs
# =============================================================================
# Set these to the base URLs of each agent. Defaults below assume Docker Compose
# service names; override with e.g. `http://localhost:8001` for bare-metal dev.
COMPLIANCE_MONITOR_URL=http://compliance_monitor:8000
TASK_AUTOMATION_URL=http://task_automation:8000
FOLLOW_UP_SEQUENCES_URL=http://follow_up_sequences:8000
FEEDBACK_LOOP_URL=http://feedback_loop:8000
PERFORMANCE_ANALYTICS_URL=http://performance_analytics:8000

# =============================================================================
# Per-agent upstream request timeouts (seconds)
# =============================================================================
COMPLIANCE_MONITOR_TIMEOUT=10.0
TASK_AUTOMATION_TIMEOUT=30.0
FOLLOW_UP_SEQUENCES_TIMEOUT=15.0
FEEDBACK_LOOP_TIMEOUT=20.0
PERFORMANCE_ANALYTICS_TIMEOUT=30.0
