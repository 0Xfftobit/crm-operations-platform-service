# =============================================================================
# Feedback Loop Service (FLS) environment configuration
# =============================================================================
# Copy this file to .env and override as needed. Defaults match local dev.

# --- App core ---
APP_NAME=crequity-feedback-loop
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1

# --- CORS / Security ---
# Allowed CORS origins. Comma-separated or JSON list (e.g. ["http://localhost:3000"]).
# Wildcard "*" is rejected in non-local environments.
CORS_ORIGINS=http://localhost:3000

# Auth for write/ops endpoints (X-API-Key header). Rotate in production.
API_KEY=change-me-dev-key

# --- Storage ---
# Backend: memory (default, volatile) | disk (writes datasets to DATA_DIR).
STORAGE_BACKEND=memory
DATA_DIR=./data/feedback_loop
MODEL_SNAPSHOT_DIR=./data/feedback_loop/models

# --- Prediction / outcome observation windows (days) ---
WINDOW_RESPONSE_DAYS=7
WINDOW_STAGE_DAYS=30
WINDOW_CONVERSION_DAYS=90
FUNDED_LABEL_WINDOW_DAYS=60

# --- Drift / performance thresholds ---
PSI_THRESHOLD=0.2
DRIFT_PERSISTENCE_EVALS=2
MIN_TRAINING_SAMPLES=50
HOLDOUT_RATIO=0.2
ACCURACY_THRESHOLD=0.70
ACCURACY_EPSILON=0.01
FAIRNESS_RATIO_MIN=0.80
FAIRNESS_RATIO_MAX=1.25

# --- Retraining ---
AUTO_RETRAIN_ENABLED=true
AUTO_RETRAIN_RISK_CLASS=low

# --- Kafka (optional) ---
# Transport degrades to in_process_bus when disabled. Set KAFKA_PRODUCE=true and
# KAFKA_BOOTSTRAP_SERVERS to publish to a real Kafka/Redpanda cluster.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCE=false
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP=crequity-feedback-loop
# Comma-separated list of consumed canonical topics.
KAFKA_TOPICS=crm.outcome.funded,crm.outcome.lost,crm.outreach.converted
