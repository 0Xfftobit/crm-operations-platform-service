APP_NAME=crequity-feedback-loop
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1

# Auth for write/ops endpoints (X-API-Key). Rotate in prod.
API_KEY=change-me-dev-key

# Storage backend: memory (default, volatile) | disk (writes datasets to DATA_DIR).
STORAGE_BACKEND=memory
DATA_DIR=./data/feedback_loop

# Prediction/outcome observation windows (days)
WINDOW_RESPONSE_DAYS=7
WINDOW_STAGE_DAYS=30
WINDOW_CONVERSION_DAYS=90
FUNDED_LABEL_WINDOW_DAYS=60

# Drift / performance thresholds
PSI_THRESHOLD=0.2
DRIFT_PERSISTENCE_EVALS=2
MIN_TRAINING_SAMPLES=50
HOLDOUT_RATIO=0.2
ACCURACY_THRESHOLD=0.70
ACCURACY_EPSILON=0.01
FAIRNESS_RATIO_MIN=0.80
FAIRNESS_RATIO_MAX=1.25

# Retraining
AUTO_RETRAIN_ENABLED=true
AUTO_RETRAIN_RISK_CLASS=low
MODEL_SNAPSHOT_DIR=./data/feedback_loop/models
