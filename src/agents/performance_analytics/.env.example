APP_NAME=crequity-performance-analytics
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1

# CORS origins. Comma-separated list or JSON array. No wildcard in prod.
CORS_ORIGINS=http://localhost:3000

# Auth for write/ops endpoints (X-API-Key). Rotate in prod.
API_KEY=change-me-dev-key

# Storage backend: memory (default, volatile) | disk (writes to DATA_DIR).
STORAGE_BACKEND=memory
DATA_DIR=./data/performance_analytics

# Attribution / windowing
ATTRIBUTION_LOOKBACK_D=90
ATTRIBUTION_DEFAULT_MODEL=time_decay
TIME_DECAY_HALFLIFE_D=14
RECON_TOLERANCE=0.005
COHORT_MIN_N=25

# Anomaly detection
ANOMALY_Z_THRESHOLD=2.0
ANOMALY_MIN_HISTORY=3

# RLS default
DEFAULT_TENANT_ID=default

# Cross-agent feedback loop fan-out (P4). Requires FEEDBACK_LOOP_URL when enabled.
OUTCOME_FANOUT_ENABLED=false
FEEDBACK_LOOP_URL=
FEEDBACK_LOOP_API_KEY=
FEEDBACK_LOOP_TIMEOUT=5.0

# Kafka event bus (aiokafka is an optional extra; in-memory fallback is used when off).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCE=false
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP=performance-analytics
# Comma-separated or JSON array. Wildcards are supported for in-memory matching.
KAFKA_TOPICS=crm.outreach.sent,crm.outreach.converted,crm.outcome.funded,crm.outcome.lost
