# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=crequity-compliance-monitoring
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ── Auth for write/ops endpoints (X-API-Key). Rotate in prod. ─────────────
API_KEY=change-me-dev-key

# ── Distributed tracing (OpenTelemetry — optional, `pip install '.[otel]'') ─
TRACING_ENABLED=false
# e.g. http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=compliance-monitoring

# ── Persistence: memory (default, volatile) | postgres (durable, needs DATABASE_URL).
STORAGE_GATEWAY=memory
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/compliance_monitoring
DATABASE_URL=
# Create tables on startup if missing (dev only; prod runs `alembic upgrade head`).
DB_AUTO_CREATE=false

# ── Hot cache: memory (default, in-process) | redis (shared across replicas + native TTL).
# Redis is optional — `pip install '.[redis]'`; degrades to memory if unavailable.
CACHE_GATEWAY=memory
REDIS_URL=redis://localhost:6379/0

# ── Upstream: the platform audit / event bus. local (none) | http (poll REST) | kafka (subscribe).
EVENT_SOURCE_GATEWAY=local
# AUDIT_SOURCE_URL=http://localhost:8003/api/v1
AUDIT_SOURCE_URL=
AUDIT_SOURCE_TIMEOUT=20
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=compliance-audit
KAFKA_PRODUCE=false
KAFKA_INGEST=false
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP=compliance-monitoring
KAFKA_TOPICS=["compliance-audit", "crm.*"]
KAFKA_GROUP_ID=compliance-monitoring
HTTP_POLL_INTERVAL_S=30

# ── Compliance parameters (System Design §7) ──────────────────────────────
ENGINE_ID=compliance-monitoring
PRECHECK_LATENCY_BUDGET_MS=80
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
FAIRNESS_RATIO_MIN=0.80
FAIRNESS_RATIO_MAX=1.25
DISPARITY_MIN_SAMPLE=100
ADVERSE_ACTION_DAYS=30
DISCLOSURE_WARN_OFFSETS=7,2
CASE_SLA_HOURS=72
AUDIT_RETENTION_YEARS=7
EXPORT_ROLES=compliance_officer,auditor,admin
ALERT_DEDUP_WINDOW_MIN=60
CHAIN_VERIFY_INTERVAL_MIN=30
DATA_RETENTION_YEARS=7
DATA_RETENTION_DAYS=0
RETENTION_WARN_DAYS=7
PII_SCAN_ENABLED=true

# ── WORM audit mirror + Merkle anchoring (tamper-evidence) ────────────────
WORM_GATEWAY=none
WORM_LOCAL_DIR=./worm_store
WORM_S3_BUCKET=
WORM_S3_PREFIX=audit/
WORM_S3_RETENTION_DAYS=2555
MERKLE_ANCHOR_INTERVAL_MIN=0

# ── Audit lifecycle: cold-storage tiering + retention purge ───────────────
AUDIT_COLD_AGE_DAYS=365
AUDIT_LIFECYCLE_INTERVAL_MIN=0
COLD_STORE_GATEWAY=none
COLD_STORE_DIR=./cold_store
COLD_STORE_S3_BUCKET=
COLD_STORE_S3_PREFIX=cold/

# ── Redis hot cache: consent TTL for the fast pre-send path ───────────────
CONSENT_CACHE_TTL_S=30

# ── Coverage-gap / dropped-event monitoring (BR-3) ────────────────────────
COVERAGE_HEARTBEAT_MAX_MIN=60
COVERAGE_SWEEP_INTERVAL_MIN=10
DEAD_LETTER_ALERT_THRESHOLD=1
