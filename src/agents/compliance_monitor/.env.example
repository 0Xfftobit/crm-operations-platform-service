APP_NAME=crequity-compliance-monitoring
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]
API_PREFIX=/api/v1

# Auth for write/ops endpoints (X-API-Key). Rotate in prod.
API_KEY=change-me-dev-key

# Distributed tracing (OpenTelemetry — optional, `pip install '.[otel]'`).
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=             # e.g. http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=compliance-monitoring

# Persistence: memory (default, volatile) | postgres (durable, needs DATABASE_URL).
STORAGE_GATEWAY=memory
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/compliance_monitoring
DATABASE_URL=
# Create tables on startup if missing (dev only; prod runs `alembic upgrade head`).
DB_AUTO_CREATE=false

# Hot cache: memory (default, in-process) | redis (shared across replicas + native TTL).
# Redis is optional — `pip install '.[redis]'`; degrades to memory if unavailable.
CACHE_GATEWAY=memory
REDIS_URL=redis://localhost:6379/0

# Upstream: the platform audit / event bus. local (none) | http (poll REST) | kafka (subscribe).
EVENT_SOURCE_GATEWAY=local
# AUDIT_SOURCE_URL=http://localhost:8003/api/v1
AUDIT_SOURCE_URL=
AUDIT_SOURCE_TIMEOUT=20
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=compliance-audit             # inbound topic (activity events consumed)
KAFKA_PRODUCE=false                      # produce compliance.alert/case/signal onto the bus
KAFKA_INGEST=false                       # run the consumer loop (streaming surveillance)
KAFKA_GROUP_ID=compliance-monitoring
HTTP_POLL_INTERVAL_S=30                   # EVENT_SOURCE_GATEWAY=http poll cadence

# ── Coverage-gap / dropped-event monitoring (BR-3) ────────────────────────
COVERAGE_HEARTBEAT_MAX_MIN=60            # a source silent longer than this is a coverage gap
DEAD_LETTER_ALERT_THRESHOLD=1           # unparseable-event count that raises an alert

# ── WORM audit mirror + Merkle anchoring (tamper-evidence) ────────────────
WORM_GATEWAY=none                        # none | local (write-once files) | s3 (Object Lock)
WORM_LOCAL_DIR=./worm_store
WORM_S3_BUCKET=
WORM_S3_PREFIX=audit/
WORM_S3_RETENTION_DAYS=2555              # S3 Object Lock COMPLIANCE retention (~7y)
MERKLE_ANCHOR_INTERVAL_MIN=0            # 0 disables periodic Merkle-root anchoring
CONSENT_CACHE_TTL_S=30                   # Redis hot-cache TTL for the pre-send consent read

# ── Audit lifecycle: cold-storage tiering + retention purge ───────────────
AUDIT_COLD_AGE_DAYS=365                  # tier hot entries to cold storage after this age
AUDIT_LIFECYCLE_INTERVAL_MIN=0          # 0 disables the periodic cold-tier + purge job
COLD_STORE_GATEWAY=none                  # none | local (dir) | s3 (bucket, e.g. Glacier)
COLD_STORE_DIR=./cold_store
COLD_STORE_S3_BUCKET=
COLD_STORE_S3_PREFIX=cold/

# ── Compliance parameters (System Design §7) ──────────────────────────────
ENGINE_ID=compliance-monitoring          # identity stamped on Engine-8 signals
PRECHECK_LATENCY_BUDGET_MS=80            # pre-send hook budget
QUIET_HOURS_START=21:00                  # TCPA quiet hours (contact local time)
QUIET_HOURS_END=08:00
FAIRNESS_RATIO_MIN=0.80                  # 4/5ths floor
FAIRNESS_RATIO_MAX=1.25
DISPARITY_MIN_SAMPLE=100                 # min cohort size before a disparity alerts
ADVERSE_ACTION_DAYS=30                   # ECOA adverse-action disclosure window
DISCLOSURE_WARN_OFFSETS=7,2              # warn N days before the deadline
CASE_SLA_HOURS=72                        # remediation SLA on an auto-opened case
AUDIT_RETENTION_YEARS=7
EXPORT_ROLES=compliance_officer,auditor,admin   # roles allowed to export the audit trail
ALERT_DEDUP_WINDOW_MIN=60                # FR-019: suppress repeat non-critical alerts in this window
CHAIN_VERIFY_INTERVAL_MIN=30            # FR-018: audit-chain integrity sweep cadence (0 disables)
DATA_RETENTION_DAYS=2555                 # Data Privacy: lead-data retention (~7y) before anonymize
RETENTION_WARN_DAYS=7                    # pre-deletion warning offset
PII_SCAN_ENABLED=true                    # FR-007: scan comm content + activity payloads for PII
