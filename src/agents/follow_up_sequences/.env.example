# Local / example environment for crequity-followup-sequence.
# Copy to .env and adjust for the target environment.

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=crequity-followup-sequence
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1
# JSON array or comma-separated list
CORS_ORIGINS=["http://localhost:3000"]

# ── Distributed tracing (OpenTelemetry — optional, pip install .[otel]) ───
TRACING_ENABLED=false
# e.g. http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=followup-sequence

# ── Auth (write/ops endpoints, X-API-Key). Rotate in prod. ────────────────
API_KEY=change-me-dev-key

# ── Persistence ───────────────────────────────────────────────────────────
# memory (volatile, default) | postgres (durable, requires DATABASE_URL)
STORAGE_GATEWAY=memory
# e.g. postgresql+psycopg://user:pass@localhost:5432/followup_sequence
DATABASE_URL=
# Create tables on startup if missing (dev only; prod runs `alembic upgrade head`)
DB_AUTO_CREATE=false

# ── Hot cache ─────────────────────────────────────────────────────────────
# memory (in-process) | redis (shared across replicas + native TTL, pip install .[redis])
CACHE_GATEWAY=memory
REDIS_URL=redis://localhost:6379/0

# ── Upstream: trigger / interaction event source ──────────────────────────
# local (no upstream) | http (poll REST) | kafka (subscribe the trigger stream)
EVENT_SOURCE_GATEWAY=local
# Required when EVENT_SOURCE_GATEWAY=http
SEQUENCE_SOURCE_URL=
SEQUENCE_SOURCE_TIMEOUT=20.0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Inbound topic to subscribe
KAFKA_TOPIC=followup-events

# ── Cross-agent Kafka bus (set to true in staging/prod when a broker is available) ─
KAFKA_PRODUCE=false
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP=followup-sequence
# Comma-separated list of consumed topics
KAFKA_TOPICS=crm.deal.stage_changed,crm.lead.scored,crm.nba.recommended

# ── Cross-agent compliance precheck (P4) ──────────────────────────────────
FUS_PRECHECK_ENABLED=false
# Required when FUS_PRECHECK_ENABLED=true
COMPLIANCE_MONITOR_URL=
COMPLIANCE_API_KEY=
FUS_PRECHECK_TIMEOUT=3.0

# ── LO/owner reply notification (FR-016) ──────────────────────────────────
# e.g. http://notification-service:8080 (falls back to log if unset)
NOTIFICATION_SERVICE_URL=
NOTIFICATION_API_KEY=
INTEGRATION_TIMEOUT_S=5.0

# ── Real channel provider credentials (optional; falls back to mock if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
WHATSAPP_BUSINESS_API_URL=
WHATSAPP_BUSINESS_API_TOKEN=

# ── Cadence / compliance parameters (System Design §7) ────────────────────
# TCPA quiet hours begin (contact-local hour)
QUIET_HOURS_START=21
# Allowed sending window = [end, start) local, i.e. 08:00–21:00
QUIET_HOURS_END=8
# Max messages/day per contact across ALL cadences
FREQ_CAP_DAY=2
# Max messages/week
FREQ_CAP_WEEK=5
# Opt-out/consent propagation bound
CONSENT_CACHE_TTL_S=60
# Pause automation after an LO manual touch
MANUAL_OUTREACH_COOLDOWN_H=24
# Channel send retry attempts
PROVIDER_RETRY_MAX=4
# 0 = tick via API (/scheduler/tick); >0 = background loop
SCHEDULER_INTERVAL_S=0
# Fallback tz for quiet hours when contact tz unknown
DEFAULT_TIMEZONE=America/New_York
# Auto-enroll on lead.scored >= this
LEAD_SCORE_THRESHOLD=70.0
