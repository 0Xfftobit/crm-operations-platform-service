APP_NAME=crequity-followup-sequence
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]
API_PREFIX=/api/v1

# Auth for write/ops endpoints (X-API-Key). Rotate in prod.
API_KEY=change-me-dev-key

# Distributed tracing (OpenTelemetry — optional, `pip install '.[otel]'`).
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=             # e.g. http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=followup-sequence

# Persistence: memory (default, volatile) | postgres (durable, needs DATABASE_URL + '.[postgres]').
STORAGE_GATEWAY=memory
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/followup_sequence
DATABASE_URL=
# Create tables on startup if missing (dev only; prod runs `alembic upgrade head`).
DB_AUTO_CREATE=false

# Hot cache: memory (default, in-process) | redis (shared across replicas + native TTL).
# Redis is optional — `pip install '.[redis]'`; degrades to memory if unavailable.
CACHE_GATEWAY=memory
REDIS_URL=redis://localhost:6379/0

# Upstream: the trigger / interaction event source. local (none) | http (poll REST) | kafka.
EVENT_SOURCE_GATEWAY=local
# SEQUENCE_SOURCE_URL=http://localhost:8000/api/v1
SEQUENCE_SOURCE_URL=
SEQUENCE_SOURCE_TIMEOUT=20
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=followup-events              # inbound (subscribed)

# ── Cadence / compliance parameters (System Design §7) ────────────────────
QUIET_HOURS_START=21                     # TCPA quiet hours begin (contact-local hour)
QUIET_HOURS_END=8                       # allowed sending window = [end, start) local, i.e. 08:00–21:00
FREQ_CAP_DAY=2                          # max messages/day per contact across ALL cadences
FREQ_CAP_WEEK=5                        # max messages/week
CONSENT_CACHE_TTL_S=60                 # opt-out/consent propagation bound
MANUAL_OUTREACH_COOLDOWN_H=24          # pause automation after an LO manual touch
PROVIDER_RETRY_MAX=4                   # channel send retry attempts
SCHEDULER_INTERVAL_S=0                 # 0 = tick via API (/scheduler/tick); >0 = background loop
DEFAULT_TIMEZONE=America/New_York      # fallback tz for quiet hours when contact tz unknown
LEAD_SCORE_THRESHOLD=70                # auto-enroll on lead.scored ≥ this
