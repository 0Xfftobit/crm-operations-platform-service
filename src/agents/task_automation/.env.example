# Core app settings (pydantic Field aliases from app/core/config.py)
APP_NAME=crequity-task-automation
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]
API_PREFIX=/api/v1
# Server port used by uvicorn / docker (not declared as a pydantic Settings Field)
PORT=8011

# Auth & engine versioning
API_KEY=change-me-dev-key
TASK_AUTOMATION_ENGINE_VERSION=rules-engine-1.0

# Storage
STORAGE_BACKEND=memory
TASK_AUTOMATION_DB_PATH=./data/tasks.db
# Required when STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://taskauto:taskauto@localhost:5433/task_automation

# Scheduler, task lifecycle & concurrency
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_S=60
DEFAULT_TASK_TIMEOUT_S=300
DEFAULT_TASK_SLA_HOURS=48
MAX_CONCURRENT_TASKS=10
DUPLICATE_TASK_WINDOW_HOURS=4

# Business rules
BUSINESS_TIMEZONE=America/Chicago
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=17
ROUND_ROBIN_AGENTS=["lo:amy","lo:bob","lo:carol"]

# Upstream service integrations (optional — events can be mocked via POST /events/ingest)
STAGE_TRACKING_URL=http://localhost:8009
STAGE_TRACKING_API_KEY=change-me-dev-key
LEAD_ASSIGNMENT_URL=
LEAD_ASSIGNMENT_API_KEY=change-me-dev-key
FOLLOW_UP_SEQUENCES_URL=
FOLLOW_UP_SEQUENCES_API_KEY=
FUS_FANOUT_ENABLED=false
INTEGRATION_TIMEOUT_S=5
# CRM / calendar stubs are used when these URLs are left empty
CRM_SERVICE_URL=                 # e.g. http://localhost:8009
CRM_API_KEY=
CALENDAR_SERVICE_URL=            # e.g. http://localhost:8007
CALENDAR_API_KEY=

# Platform dependencies
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCE=false
KAFKA_CONSUMER_GROUP=task-automation-engine
KAFKA_CONSUMER_ENABLED=false
KAFKA_TOPICS=["crm.deal.stage_changed","crm.lead.assigned","crm.document.received"]
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_ENABLED=false
TEMPORAL_TASK_QUEUE=task-automation
REDIS_URL=redis://localhost:6379/0

# Guardrails, rollout & LLM provider
MAX_ACTIONS_PER_DEAL=25
MAX_RULE_CHAIN_DEPTH=10
CANARY_DEFAULT_PERCENT=1.0
LLM_CONFIDENCE_THRESHOLD=0.85
# LLM provider (optional — falls back to stub if unset)
# Use any OpenAI-compatible chat-completions endpoint.
LLM_PROVIDER_URL=                 # e.g. https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=10
MANDATORY_DRY_RUN_BEFORE_PUBLISH=true

# Idempotency, retries, activity & loop budgets
IDEMPOTENCY_BACKEND=memory
# Set to redis with REDIS_URL for production idempotency store
# IDEMPOTENCY_BACKEND=redis
IDEMPOTENCY_TTL_DAYS=7
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=30
RETRY_BACKOFF_MAX_SECONDS=300
RETRY_BACKOFF_COEFFICIENT=2.0
ACTIVITY_TIMEOUT_S=30
LOOP_BUDGET_TTL_HOURS=1
BLAST_RADIUS_WARNING_THRESHOLD=100

# Feature store
FEATURE_STORE_URL=
FEATURE_STORE_API_KEY=

# Exports
EXPORT_LOCAL_DIR=./data/exports
S3_EXPORT_BUCKET=
S3_EXPORT_PREFIX=task-automation/ledger
S3_EXPORT_REGION=

# Observability
OTEL_ENABLED=false
