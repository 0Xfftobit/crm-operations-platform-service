{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploySecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/operations/DATABASE_URL-*",
        "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:crm/operations/API_KEY-*"
      ]
    }
  ]
}
