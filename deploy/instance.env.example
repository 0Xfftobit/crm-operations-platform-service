# ── crm-operations-platform-service — env for the unified image on THIS EC2 instance (one repo per instance) ──
# 1. sudo install -m 600 deploy/instance.env.example /etc/crm/env && sudo vi /etc/crm/env
# 2. docker compose up -d --build      3. curl -s localhost:8080/health
# The image is self-configuring: db_bootstrap.py + supervisord wire every agent's storage/schema and
# the internal 127.0.0.1:800x routes. You supply only the few globals below. Do NOT copy the per-agent
# .env files onto the instance.

# ── REQUIRED — Neon persistence (the ONE base DSN; identical on all instances) ──
DATABASE_URL=postgresql+psycopg://neondb_owner:<ROTATED_PW>@ep-super-sound-ay9w5vhg.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── RECOMMENDED — turns on X-API-Key auth for all agents (unset ⇒ endpoints are unauthenticated) ──
API_KEY=<strong-key>

# ── OPTIONAL globals (safe here — same meaning for every agent that reads them) ──
#CACHE_GATEWAY=redis
#REDIS_URL=redis://<host>:6379/0
#TRACING_ENABLED=true
#OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector>:4318/v1/traces
#LLM_CONFIDENCE_THRESHOLD=0.7        # task_automation LLM-assist tuning (has a safe default)

# ── ⚠ DO NOT set these at the container level — same NAME, different MEANING per agent ──
#   QUIET_HOURS_START / QUIET_HOURS_END — compliance_monitor uses HH:MM (21:00/08:00); follow_up_sequences uses an int hour (21/8)
#   KAFKA_TOPIC                         — differ per agent (compliance-audit, followup-events)
#   OTEL_SERVICE_NAME                   — each agent reports its own
#   APP_NAME                            — per-agent identity
#   → to change one of these for a SINGLE agent, set it in that agent's block in deploy/supervisord.conf.

# ── env resolution (highest wins): supervisord environment=  >  this file  >  config.py defaults ──
#   global/shared value → here   |   one agent's override → supervisord.conf   |   fine as default → leave unset
